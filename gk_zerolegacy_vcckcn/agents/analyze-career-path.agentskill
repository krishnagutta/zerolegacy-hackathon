      gapName: "Digital HR Transformation",
      explanation: "Modern CHROs drive tech-enabled HR strategies",
      timeToClose: "4-6 months",
      learningResource: "HR Tech Trends Course",
      mentorSuggestion: "Partner with CTO on people systems roadmap",
      projectSuggestion: "Champion AI-powered talent analytics implementation"
    },
    {
      priority: "Low",
      priorityColor: "#d1fae5",
      gapName: "M&A People Integration",
