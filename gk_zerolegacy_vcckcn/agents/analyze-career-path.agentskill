    {
      jobTitle: "Chief Human Resources Officer",
      department: "Executive Leadership",
      location: "San Francisco (HQ)",
      matchPercent: 78,
      skillsMatch: "Strategic HR, Talent Development, Change Management",
      growthArea: "C-Suite Executive Presence",
      whyThisFits: "Natural next step leveraging your 25-year HR leadership track record",
      confidence: 85,
      requisitionId: "R-EXEC-001"
    },
    {
      jobTitle: "VP, Global Talent & Culture",
      department: "Human Resources",
